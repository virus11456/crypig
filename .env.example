# 複製成 .env 填入你的金鑰（docker-compose 會自動讀）
# 都可留空——留空的資料源會自動跳過、不影響其他功能。

# CoinGecko Demo 金鑰（市值/OI-Cap/Vol-Cap；免費申請）
COINGECKO_API_KEY=

# Reddit 散戶討論熱度（免費 script app；唯讀 OAuth）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# LunarCrush 社群情緒/KOL（需付費 Individual 方案，可留空）
LUNARCRUSH_API_KEY=

# RAG 問答用 Claude（留空則用內建 mock 問答）
ANTHROPIC_API_KEY=
